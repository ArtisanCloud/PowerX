# PowerX Admin 开发环境示例
# 生产打包请使用 .env.prod.example（复制为 .env.prod 供 make dist 读取）

# ===== 语言配置 =====
# 默认语言 (zh, en, ja, ko)
NUXT_DEFAULT_LANGUAGE=zh

# 可用语言列表 (逗号分隔)
NUXT_AVAILABLE_LANGUAGES=zh,en,ja,ko

# 强制语言 (如果设置，用户无法切换语言)
# NUXT_FORCE_LANGUAGE=zh

# 是否启用语言切换功能 (true/false)
NUXT_ENABLE_LANGUAGE_SWITCH=true

# ===== 主题配置 =====
# 默认主题 (light, dark, auto)
NUXT_DEFAULT_THEME=dark

# 可用主题列表 (逗号分隔)
NUXT_AVAILABLE_THEMES=light,dark,auto

# 强制主题 (如果设置，用户无法切换主题)
# NUXT_FORCE_THEME=dark

# 是否启用主题切换功能 (true/false)
NUXT_ENABLE_THEME_SWITCH=true

# ===== 应用配置 =====
# 应用名称
NUXT_APP_NAME=PowerX Admin

# 应用版本
NUXT_APP_VERSION=dev

# 调试模式 (true/false)
NUXT_DEBUG_MODE=false

# ===== 功能开关 =====
# 是否启用用户偏好设置 (true/false)
NUXT_ENABLE_USER_PREFERENCES=true

# ===== 其他现有配置 =====
# API 上游地址（dev 默认示例）
POWERX_BACKEND=http://127.0.0.1:8077

# WebSocket 上游地址（dev 默认示例）
WS_UPSTREAM=ws://127.0.0.1:8077/api/ws

# 生产环境参考：
# POWERX_BACKEND=http://127.0.0.1:8080
# WS_UPSTREAM=ws://127.0.0.1:8080/api/ws

# 是否输出宿主↔插件桥接调试日志（sync/theme/locale/auth-token）
# 仅在为 "true" 时打印
NUXT_PUBLIC_BRIDGE_DEBUG=false
