// handleError 处理错误并转换为gRPC状态码
func (s *{{.EntityName}}ServiceServer) handleError(err error) error {
	if err == nil {
		return nil
	}

	errorMsg := err.Error()

	// 根据错误类型返回相应的gRPC状态码
	switch {
	case strings.Contains(errorMsg, "not found"):
		return status.Error(codes.NotFound, errorMsg)
	case strings.Contains(errorMsg, "already exists"):
		return status.Error(codes.AlreadyExists, errorMsg)
	case strings.Contains(errorMsg, "invalid"):
		return status.Error(codes.InvalidArgument, errorMsg)
	case strings.Contains(errorMsg, "unauthorized"):
		return status.Error(codes.Unauthenticated, errorMsg)
	case strings.Contains(errorMsg, "forbidden"):
		return status.Error(codes.PermissionDenied, errorMsg)
	case strings.Contains(errorMsg, "timeout"):
		return status.Error(codes.DeadlineExceeded, errorMsg)
	case strings.Contains(errorMsg, "unavailable"):
		return status.Error(codes.Unavailable, errorMsg)
	default:
		return status.Error(codes.Internal, errorMsg)
	}
}

