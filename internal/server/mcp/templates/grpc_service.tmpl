{{if .HasStreamRPC}}
// Stream{{.EntityName}} 流式获取{{.Description}}
func (s *{{.EntityName}}ServiceServer) Stream{{.EntityName}}(req *pb.Stream{{.EntityName}}Request, stream pb.{{.EntityName}}Service_Stream{{.EntityName}}Server) error {
{{if .HasMetrics}}	s.metrics.IncrementCounter("grpc_{{.PackageName}}_{{.EntityName}}_stream_total")
	defer func(start time.Time) {
		s.metrics.RecordDuration("grpc_{{.PackageName}}_{{.EntityName}}_stream_duration", time.Since(start))
	}(time.Now())
{{end}}

	// 验证请求参数
	if req == nil {
		return status.Error(codes.InvalidArgument, "请求不能为空")
	}

	ctx := stream.Context()

	// 转换为DTO
	dtoReq := s.convertStreamRequestToDTO(req)

	// 创建结果通道
	resultChan := make(chan *{{.PackageName}}.{{.EntityName}}Response, 100)
	errorChan := make(chan error, 1)

	// 启动流式处理
	go func() {
		defer close(resultChan)
		defer close(errorChan)

		err := s.{{.EntityName}}UseCase.Stream{{.EntityName}}(ctx, dtoReq, resultChan)
		if err != nil {
			errorChan <- err
		}
	}()

	// 处理结果流
	for {
		select {
		case <-ctx.Done():
			return ctx.Err()
		case err := <-errorChan:
			if err != nil {
{{if .HasLogger}}				s.logger.ErrorF(ctx, "流式获取{{.Description}}失败: %v", err)
{{end}}				return s.handleError(err)
			}
			return nil
		case result, ok := <-resultChan:
			if !ok {
				return nil
			}

			// 发送结果
			pbResult := s.convertDTOToResponse(result)
			if err := stream.Send(pbResult); err != nil {
{{if .HasLogger}}				s.logger.ErrorF(ctx, "发送流式{{.Description}}数据失败: %v", err)
{{end}}				return err
			}
		}
	}
}
{{end}}

