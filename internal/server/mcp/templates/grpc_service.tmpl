func (s *{{.EntityName}}ServiceServer) convertDTOToListResponse(dto *{{.PackageName}}.{{.EntityName}}ListResponse) *pb.List{{.EntityName}}Response {
	if dto == nil {
		return &pb.List{{.EntityName}}Response{}
	}

	items := make([]*pb.{{.EntityName}}Response, len(dto.Items))
	for i, item := range dto.Items {
		items[i] = s.convertDTOToResponse(item)
	}

	return &pb.List{{.EntityName}}Response{
		Items: items,
		Pagination: &pb.PaginationResponse{
			Page:       int32(dto.Pagination.Page),
			PageSize:   int32(dto.Pagination.PageSize),
			Total:      dto.Pagination.Total,
			TotalPages: int32(dto.Pagination.TotalPages),
		},
	}
}
