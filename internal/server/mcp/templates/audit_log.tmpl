// logAudit 记录审计日志
func (a *{{.EntityName}}AuditLogger) logAudit(ctx context.Context, auditLog *audit.AuditLog) error {
	// 异步记录审计日志，避免影响主业务流程
	go func() {
		if err := a.auditRepository.Create(context.Background(), auditLog); err != nil {
{{if .HasLogger}}			a.logger.ErrorF(context.Background(), "记录{{.Description}}审计日志失败: %v", err)
{{end}}		}
	}()

	return nil
}

// buildContext 构建审计上下文
func (a *{{.EntityName}}AuditLogger) buildContext(ctx context.Context, auditCtx *AuditContext) map[string]interface{} {
	contextData := make(map[string]interface{})

	if auditCtx != nil {
		if auditCtx.UserID != "" {
			contextData["user_id"] = auditCtx.UserID
		}
		if auditCtx.UserName != "" {
			contextData["username"] = auditCtx.UserName
		}
		if auditCtx.UserRole != "" {
			contextData["user_role"] = auditCtx.UserRole
		}
		if auditCtx.IPAddress != "" {
			contextData["ip_address"] = auditCtx.IPAddress
		}
		if auditCtx.UserAgent != "" {
			contextData["user_agent"] = auditCtx.UserAgent
		}
		if auditCtx.SessionID != "" {
			contextData["session_id"] = auditCtx.SessionID
		}
		if auditCtx.RequestID != "" {
			contextData["request_id"] = auditCtx.RequestID
		}
		if auditCtx.Module != "" {
			contextData["module"] = auditCtx.Module
		}
		for k, v := range auditCtx.Extra {
			contextData[k] = v
		}
	}

{{if .HasAuth}}	// 尝试从上下文获取用户信息
	if userID := auth.GetUserIDFromContext(ctx); userID != "" && contextData["user_id"] == nil {
		contextData["user_id"] = userID
	}
{{end}}

{{if .HasIP}}	// 尝试从上下文获取IP地址
	if ipAddress := network.GetIPFromContext(ctx); ipAddress != "" && contextData["ip_address"] == nil {
		contextData["ip_address"] = ipAddress
	}
{{end}}

	// 添加模块信息
	if contextData["module"] == nil {
		contextData["module"] = "{{.PackageName}}"
	}

	return contextData
}

// buildAuditData 构建审计数据
func (a *{{.EntityName}}AuditLogger) buildAuditData(before, after, changes interface{}) map[string]interface{} {
	data := make(map[string]interface{})

	if before != nil {
		data["before"] = a.sanitizeData(before)
	}
	if after != nil {
		data["after"] = a.sanitizeData(after)
	}
	if changes != nil {
		data["changes"] = a.sanitizeData(changes)
	}

	return data
}

// sanitizeData 清理敏感数据
func (a *{{.EntityName}}AuditLogger) sanitizeData(data interface{}) interface{} {
	// 将数据转换为map以便处理
	dataBytes, err := json.Marshal(data)
	if err != nil {
		return data
	}

	var dataMap map[string]interface{}
	if err := json.Unmarshal(dataBytes, &dataMap); err != nil {
		return data
	}

	// 清理敏感字段
	sensitiveFields := []string{
{{range .SensitiveFields}}		"{{.}}",
{{end}}	}

	for _, field := range sensitiveFields {
		if _, exists := dataMap[field]; exists {
			dataMap[field] = "[REDACTED]"
		}
	}

	return dataMap
}

// calculateChanges 计算数据变更
func (a *{{.EntityName}}AuditLogger) calculateChanges(before, after interface{}) map[string]interface{} {
	changes := make(map[string]interface{})

	// 转换为JSON进行比较
	beforeBytes, err := json.Marshal(before)
	if err != nil {
		return changes
	}

	afterBytes, err := json.Marshal(after)
	if err != nil {
		return changes
	}

	var beforeMap, afterMap map[string]interface{}
	if err := json.Unmarshal(beforeBytes, &beforeMap); err != nil {
		return changes
	}
	if err := json.Unmarshal(afterBytes, &afterMap); err != nil {
		return changes
	}

	// 比较字段变更
	for key, afterValue := range afterMap {
		beforeValue, exists := beforeMap[key]
		if !exists || !a.isEqual(beforeValue, afterValue) {
			changes[key] = map[string]interface{}{
				"from": beforeValue,
				"to":   afterValue,
			}
		}
	}

	return changes
}

// isEqual 比较两个值是否相等
func (a *{{.EntityName}}AuditLogger) isEqual(a1, a2 interface{}) bool {
	bytes1, err1 := json.Marshal(a1)
	bytes2, err2 := json.Marshal(a2)
	if err1 != nil || err2 != nil {
		return false
	}
	return string(bytes1) == string(bytes2)
}

