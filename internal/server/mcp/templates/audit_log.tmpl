// AuditAction 审计操作类型
type AuditAction string

const (
{{range .AuditActions}}	// {{.Name}} {{.Description}}
	{{.Name}} AuditAction = "{{.Value}}"
{{end}}
)

// AuditLevel 审计级别
type AuditLevel string

const (
	// AuditLevelInfo 信息级别
	AuditLevelInfo AuditLevel = "info"
	// AuditLevelWarn 警告级别
	AuditLevelWarn AuditLevel = "warn"
	// AuditLevelError 错误级别
	AuditLevelError AuditLevel = "error"
	// AuditLevelCritical 严重级别
