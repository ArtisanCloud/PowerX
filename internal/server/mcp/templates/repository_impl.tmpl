// {{.EntityName}}RepositoryImpl {{.Description}}仓储实现
type {{.EntityName}}RepositoryImpl struct {
	*repository.BaseRepository[model.{{.EntityName}}]
	db *gorm.DB
{{if .HasCache}}	cache CacheInterface
{{end}}
{{if .HasLogger}}	logger LoggerInterface
{{end}}
}

// New{{.EntityName}}Repository 创建{{.Description}}仓储实例
func New{{.EntityName}}Repository(db *gorm.DB{{if .HasCache}}, cache CacheInterface{{end}}{{if .HasLogger}}, logger LoggerInterface{{end}}) {{.PackageName}}.{{.EntityName}}Repository {
	return &{{.EntityName}}RepositoryImpl{
		BaseRepository: repository.NewBaseRepository[model.{{.EntityName}}](db),
		db:            db,
{{if .HasCache}}		cache:         cache,
{{end}}
{{if .HasLogger}}		logger:        logger,
{{end}}	}
}

// Create 创建{{.Description}}
func (r *{{.EntityName}}RepositoryImpl) Create(ctx context.Context, entity *{{.PackageName}}.{{.EntityName}}) error {
	// 转换为持久化模型
	persistenceModel := r.toPersistenceModel(entity)
	
	// 执行创建
	if err := r.db.WithContext(ctx).Create(persistenceModel).Error; err != nil {
		return fmt.Errorf("创建{{.Description}}失败: %w", err)
	}
	
	// 更新实体ID
	entity.ID = persistenceModel.ID
	
{{if .HasCache}}	// 清除相关缓存
	r.clearRelatedCache(ctx, entity.ID)
{{end}}
	
	return nil
}

// GetByID 根据ID获取{{.Description}}
func (r *{{.EntityName}}RepositoryImpl) GetByID(ctx context.Context, id string) (*{{.PackageName}}.{{.EntityName}}, error) {
	if id == "" {
		return nil, errors.New("ID不能为空")
	}
	
{{if .HasCache}}	// 尝试从缓存获取
	if cached, err := r.getFromCache(ctx, id); err == nil && cached != nil {
		return cached, nil
	}
{{end}}
	
	var persistenceModel model.{{.EntityName}}
	if err := r.db.WithContext(ctx).First(&persistenceModel, "id = ?", id).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, nil
		}
		return nil, fmt.Errorf("查询{{.Description}}失败: %w", err)
	}
	
	entity := r.toDomainModel(&persistenceModel)
	
{{if .HasCache}}	// 设置缓存
	r.setToCache(ctx, id, entity)
{{end}}
	
	return entity, nil
}

// Update 更新{{.Description}}
func (r *{{.EntityName}}RepositoryImpl) Update(ctx context.Context, entity *{{.PackageName}}.{{.EntityName}}) error {
	if entity.ID == "" {
		return errors.New("实体ID不能为空")
	}
	
	// 转换为持久化模型
	persistenceModel := r.toPersistenceModel(entity)
	
	// 执行更新
	result := r.db.WithContext(ctx).Model(&persistenceModel).Where("id = ?", entity.ID).Updates(persistenceModel)
	if result.Error != nil {
		return fmt.Errorf("更新{{.Description}}失败: %w", result.Error)
	}
	
	if result.RowsAffected == 0 {
		return errors.New("{{.Description}}不存在或未发生变更")
	}
	
{{if .HasCache}}	// 清除相关缓存
	r.clearRelatedCache(ctx, entity.ID)
{{end}}
	
	return nil
}

// Delete 删除{{.Description}}
func (r *{{.EntityName}}RepositoryImpl) Delete(ctx context.Context, id string) error {
	if id == "" {
		return errors.New("ID不能为空")
	}
	
	result := r.db.WithContext(ctx).Delete(&model.{{.EntityName}}{}, "id = ?", id)
	if result.Error != nil {
		return fmt.Errorf("删除{{.Description}}失败: %w", result.Error)
	}
	
	if result.RowsAffected == 0 {
		return errors.New("{{.Description}}不存在")
	}
	
{{if .HasCache}}	// 清除相关缓存
	r.clearRelatedCache(ctx, id)
{{end}}
	
	return nil
}

// List 分页查询{{.Description}}列表
func (r *{{.EntityName}}RepositoryImpl) List(ctx context.Context, page *model.Page) ([]*{{.PackageName}}.{{.EntityName}}, int64, error) {
	var persistenceModels []model.{{.EntityName}}
	var total int64
	
	// 构建查询
	query := r.db.WithContext(ctx).Model(&model.{{.EntityName}}{})
	
	// 计算总数
	if err := query.Count(&total).Error; err != nil {
		return nil, 0, fmt.Errorf("查询{{.Description}}总数失败: %w", err)
	}
	
	// 分页查询
	offset := (page.PageNum - 1) * page.PageSize
	if err := query.Offset(offset).Limit(page.PageSize).Find(&persistenceModels).Error; err != nil {
		return nil, 0, fmt.Errorf("查询{{.Description}}列表失败: %w", err)
	}
	
	// 转换为领域模型
	entities := make([]*{{.PackageName}}.{{.EntityName}}, len(persistenceModels))
	for i, pm := range persistenceModels {
		entities[i] = r.toDomainModel(&pm)
	}
	
	return entities, total, nil
}

