// toDomainModel 转换为领域模型
func (r *{{.EntityName}}RepositoryImpl) toDomainModel(pm *model.{{.EntityName}}) *{{.PackageName}}.{{.EntityName}} {
	if pm == nil {
		return nil
	}
	
	return &{{.PackageName}}.{{.EntityName}}{
		ID:        pm.ID,
		CreatedAt: pm.CreatedAt,
		UpdatedAt: pm.UpdatedAt,
		DeletedAt: pm.DeletedAt.Time,
{{range .Fields}}		{{.Name}}: pm.{{.Name}},
{{end}}	}
}

// toPersistenceModel 转换为持久化模型
func (r *{{.EntityName}}RepositoryImpl) toPersistenceModel(dm *{{.PackageName}}.{{.EntityName}}) *model.{{.EntityName}} {
	if dm == nil {
		return nil
	}
	
	return &model.{{.EntityName}}{
		ID:        dm.ID,
		CreatedAt: dm.CreatedAt,
		UpdatedAt: dm.UpdatedAt,
{{range .Fields}}		{{.Name}}: dm.{{.Name}},
{{end}}	}
}

