# 二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制文件，使用go test -c构建
*.test

# 输出的二进制文件
*.out

# Go工作空间文件
go.work

# 依赖验证文件
go.sum

# 编辑器和IDE文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log

# 临时文件
tmp/
temp/

# 环境配置文件
.env
.env.local
.env.*.local

# 构建输出
dist/
build/

backend/etc/config.yaml
backend/etc/setup.wizard.config.json

# PowerX plugin runtime（整目录忽略）
backend/plugins/
backend/.gopath
backend/.gotmp

# Ignore compiled binary files and specific app directories
# Binary file 'app' (compiled executable at repository root)
/app

# Allow web-admin/app directory (it has source code, not a build artifact)
!web-admin/app/

# Backend app directory (build output)
backend/app/
# Frontend app directory (if exists)
frontend/app/
# CLI app directory (if exists)
cli/app/

# Specifically allow plugin-release pages within web-admin
!web-admin/app/pages/plugin-release/
!web-admin/app/pages/plugin-release/**
!web-admin/app/pages/knowledge-spaces/
!web-admin/app/pages/knowledge-spaces/**

api/grpc/gen/*
!api/grpc/gen/go/
!api/grpc/gen/go/**

.gocache
.cache
.gomodcache
storage/

.claude

tmp
backend/reports/
reports/

/backend/app
