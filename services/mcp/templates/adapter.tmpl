// NotificationRequest 通知请求
type NotificationRequest struct {
	Type      string                 `json:"type"`
	Recipient string                 `json:"recipient"`
	Title     string                 `json:"title"`
	Content   string                 `json:"content"`
	Data      map[string]interface{} `json:"data,omitempty"`
}

// SendNotification 发送通知
func (a *{{.EntityName}}AdapterImpl) SendNotification(ctx context.Context, notification *NotificationRequest) error {
	if notification == nil {
		return fmt.Errorf("通知请求不能为空")
	}

	// 发送通知
	if err := a.notificationClient.Send(ctx, notification); err != nil {
		return fmt.Errorf("发送通知失败: %w", err)
	}

{{if .HasLogger}}	a.logger.InfoF(ctx, "成功发送{{.Description}}通知: %s", notification.Type)
{{end}}

	return nil
}

// SendBatchNotifications 批量发送通知
func (a *{{.EntityName}}AdapterImpl) SendBatchNotifications(ctx context.Context, notifications []*NotificationRequest) error {
	if len(notifications) == 0 {
		return fmt.Errorf("通知列表不能为空")
	}

	// 批量发送通知
	if err := a.notificationClient.BatchSend(ctx, notifications); err != nil {
		return fmt.Errorf("批量发送通知失败: %w", err)
	}

{{if .HasLogger}}	a.logger.InfoF(ctx, "成功批量发送{{.Description}}通知: %d条", len(notifications))
{{end}}

	return nil
}
{{end}}

