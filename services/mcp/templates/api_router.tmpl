// Register{{ index .Vars "EntityName" }}Routes 注册{{ index .Vars "Description" }}相关路由
func Register{{ index .Vars "EntityName" }}Routes(r *gin.RouterGroup, handler *{{ index .Vars "PackageName" }}.{{ index .Vars "EntityName" }}Handler) {
	// {{ index .Vars "Description" }}路由组
	{{ index .Vars "PackageName" }}Group := r.Group("/{{ index .Vars "APIPrefix" }}")
	{
{{if index .Params "HasAuth"}}		// 需要认证的路由
		authGroup := {{ index .Vars "PackageName" }}Group.Group("")
		authGroup.Use(middleware.AuthRequired())
		{
{{if index .Params "HasCreateAPI"}}			// 创建{{ index .Vars "Description" }}
			authGroup.POST("", handler.Create{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasUpdateAPI"}}			// 更新{{ index .Vars "Description" }}
			authGroup.PUT("/:id", handler.Update{{ index .Vars "EntityName" }})
			authGroup.PATCH("/:id", handler.Patch{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasDeleteAPI"}}			// 删除{{ index .Vars "Description" }}
			authGroup.DELETE("/:id", handler.Delete{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasBatchAPI"}}			// 批量操作
			authGroup.POST("/batch", handler.BatchCreate{{ index .Vars "EntityName" }})
			authGroup.PUT("/batch", handler.BatchUpdate{{ index .Vars "EntityName" }})
			authGroup.DELETE("/batch", handler.BatchDelete{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasImportExportAPI"}}			// 导入导出
			authGroup.POST("/import", handler.Import{{ index .Vars "EntityName" }})
			authGroup.GET("/export", handler.Export{{ index .Vars "EntityName" }})
{{end}}
		}
{{end}}

{{if index .Params "HasPublicAPI"}}		// 公开路由（无需认证）
{{if index .Params "HasGetAPI"}}		// 获取{{ index .Vars "Description" }}详情
		{{ index .Vars "PackageName" }}Group.GET("/:id", handler.Get{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasListAPI"}}		// 获取{{ index .Vars "Description" }}列表
		{{ index .Vars "PackageName" }}Group.GET("", handler.List{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasSearchAPI"}}		// 搜索{{ index .Vars "Description" }}
		{{ index .Vars "PackageName" }}Group.GET("/search", handler.Search{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasStatsAPI"}}		// 统计信息
		{{ index .Vars "PackageName" }}Group.GET("/stats", handler.Get{{ index .Vars "EntityName" }}Stats)
{{end}}
{{else}}		// 需要认证的路由
		authGroup := {{ index .Vars "PackageName" }}Group.Group("")
		authGroup.Use(middleware.AuthRequired())
		{
{{if index .Params "HasGetAPI"}}			// 获取{{ index .Vars "Description" }}详情
			authGroup.GET("/:id", handler.Get{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasListAPI"}}			// 获取{{ index .Vars "Description" }}列表
			authGroup.GET("", handler.List{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasSearchAPI"}}			// 搜索{{ index .Vars "Description" }}
			authGroup.GET("/search", handler.Search{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasStatsAPI"}}			// 统计信息
			authGroup.GET("/stats", handler.Get{{ index .Vars "EntityName" }}Stats)
{{end}}
		}
{{end}}

{{if index .Params "HasAdminAPI"}}		// 管理员路由
		adminGroup := {{ index .Vars "PackageName" }}Group.Group("/admin")
		adminGroup.Use(middleware.AuthRequired(), middleware.AdminRequired())
		{
{{if index .Params "HasAdminListAPI"}}			// 管理员获取{{ index .Vars "Description" }}列表
			adminGroup.GET("", handler.AdminList{{ index .Vars "EntityName" }})
{{end}}
{{if index .Params "HasAdminStatsAPI"}}			// 管理员统计信息
			adminGroup.GET("/stats", handler.AdminGet{{ index .Vars "EntityName" }}Stats)
{{end}}
{{if index .Params "HasAdminOperationAPI"}}			// 管理员操作
			adminGroup.POST("/:id/enable", handler.Enable{{ index .Vars "EntityName" }})
			adminGroup.POST("/:id/disable", handler.Disable{{ index .Vars "EntityName" }})
			adminGroup.POST("/:id/approve", handler.Approve{{ index .Vars "EntityName" }})
			adminGroup.POST("/:id/reject", handler.Reject{{ index .Vars "EntityName" }})
{{end}}
		}
{{end}}

{{if index .Params "HasFileAPI"}}		// 文件相关路由
		fileGroup := {{ index .Vars "PackageName" }}Group.Group("/files")
		fileGroup.Use(middleware.AuthRequired())
		{
			// 上传文件
			fileGroup.POST("/upload", handler.Upload{{ index .Vars "EntityName" }}File)
			// 下载文件
			fileGroup.GET("/download/:fileId", handler.Download{{ index .Vars "EntityName" }}File)
			// 删除文件
			fileGroup.DELETE("/:fileId", handler.Delete{{ index .Vars "EntityName" }}File)
		}
{{end}}

{{if index .Params "HasCustomRoutes"}}		// 自定义路由
{{ $customRoutes := index .Params "CustomRoutes" }}
{{range $cr := $customRoutes}}		{{if index $cr "RequireAuth"}}authGroup{{else}}{{ index $.Vars "PackageName" }}Group{{end}}.{{ index $cr "Method" }}("{{ index $cr "Path" }}", handler.{{ index $cr "Handler" }})
{{end}}
{{end}}
	}
}

