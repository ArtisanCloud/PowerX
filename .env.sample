# Event Fabric defaults
CORE_X_EVENT_FABRIC_ACK_TIMEOUT_SEC=30
CORE_X_EVENT_FABRIC_DEFAULT_MAX_RETRY=5
CORE_X_EVENT_FABRIC_REDIS_ADDR=localhost:6379
CORE_X_EVENT_FABRIC_REDIS_PASSWORD=
CORE_X_EVENT_FABRIC_REDIS_DB=1
CORE_X_EVENT_FABRIC_RETRY_KEY_PREFIX=event_fabric:retry
CORE_X_EVENT_FABRIC_REPLAY_KEY_PREFIX=event_fabric:replay
CORE_X_EVENT_FABRIC_SCHEDULER_INTERVAL=5

# Capability Registry defaults
CORE_X_CAPABILITY_REGISTRY_REDIS_PREFIX=capability_registry:cache
CORE_X_CAPABILITY_REGISTRY_EVENT_TOPIC_PREFIX=capability.catalog
CORE_X_CAPABILITY_REGISTRY_RATE_LIMIT_LIMIT=60
CORE_X_CAPABILITY_REGISTRY_RATE_LIMIT_BURST=120
CORE_X_CAPABILITY_REGISTRY_RATE_LIMIT_WINDOW=60
