    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migration_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payloads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "core",
                  "agent",
                  "knowledge",
                  "catalog"
                ]
              },
              "checksum": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "name",
              "checksum"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "postgres_major": {
          "type": "array",
          "items": {
            "const": 16
          },
          "minItems": 1,
          "maxItems": 1
        },
        "required_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_changes": {
          "type": "boolean"
        },
        "data_backfill": {
          "type": "boolean"
        },
        "system_catalog": {
          "type": "boolean"
        },
        "knowledge_binding_in_plan": {
          "const": true
        }
      },
      "required": [
        "migration_version",
        "payloads",
        "postgres_major",
        "required_extensions",
        "schema_changes",
        "data_backfill",
        "system_catalog",
        "knowledge_binding_in_plan"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changes": {
          "type": "array",
          "maxItems": 0
        },
        "preserve_installed": {
          "const": true
        },
        "write_configuration": {
          "const": false
        },
        "missing_configuration": {
          "const": "block"
        }
      },
      "required": [
        "changes",
        "preserve_installed",
        "write_configuration",
        "missing_configuration"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_bridge": {
          "const": 2
        },
        "session_action": {
          "const": "relogin_if_legacy_access_token"
        },
        "plugin_validation": {
          "type": "string"
        },
        "post_upgrade_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validated_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage_drivers",
            "vector_topologies",
            "plugins",
            "other_bindings"
          ],
          "properties": {
            "storage_drivers": {
              "type": "array",
              "items": {
                "const": "local"
              }
            },
            "vector_topologies": {
              "type": "array",
              "items": {
                "enum": [
                  "same_core_database",
                  "disabled"
                ]
              }
            },
            "plugins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "const": "com.powerx.upgrade.fixture"
                  },
                  "version": {
                    "const": "1.0.0"
                  }
                }
              }
            },
            "other_bindings": {
              "const": "require_additional_acceptance"
            }
          }
        }
      },
      "required": [
        "host_bridge",
        "session_action",
        "plugin_validation",
        "post_upgrade_actions",
        "validated_scope"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "offline"
        },
        "stop_all_writers": {
          "const": true
        },
        "lock_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "nontransactional_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery": {
          "const": "restore_matching_pre_upgrade_backup"
        },
        "strict_configuration": {
          "const": true
        }
      },
      "required": [
        "mode",
        "stop_all_writers",
        "lock_timeout_seconds",
        "nontransactional_steps",
        "recovery",
        "strict_configuration"
      ]
