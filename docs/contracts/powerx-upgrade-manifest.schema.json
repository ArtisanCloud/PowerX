{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerx.artisan-cloud.com/contracts/powerx-upgrade-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "powerx.upgrade-manifest/v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^sha-[a-f0-9]{40}$"
    },
    "channel": {
      "enum": [
        "development",
        "stable"
      ]
    },
    "version": {
      "type": "string"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "executable": {
      "const": true
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "const": "ghcr.io/artisancloud/powerx-backend"
            },
            "index_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "platforms": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "linux/amd64": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "digest",
                    "source_revision"
                  ]
                },
                "linux/arm64": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "digest",
                    "source_revision"
                  ]
                }
              }
            }
          },
          "required": [
            "repository",
            "index_digest",
            "platforms"
          ]
        },
        "web_admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "const": "ghcr.io/artisancloud/powerx-web-admin"
            },
            "index_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "platforms": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "linux/amd64": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "digest",
                    "source_revision"
                  ]
                },
                "linux/arm64": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "digest",
                    "source_revision"
                  ]
                }
              }
            }
          },
          "required": [
            "repository",
            "index_digest",
            "platforms"
          ]
        }
      },
      "required": [
        "backend",
        "web_admin"
      ]
    },
    "supported_from": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "pattern": "^sha-[a-f0-9]{40}$"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "images": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backend": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "const": "ghcr.io/artisancloud/powerx-backend"
                  },
                  "index_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "platforms": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "linux/amd64": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "source_revision": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                          }
                        },
                        "required": [
                          "digest",
                          "source_revision"
                        ]
                      },
                      "linux/arm64": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "source_revision": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                          }
                        },
                        "required": [
                          "digest",
                          "source_revision"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "repository",
                  "index_digest",
                  "platforms"
                ]
              },
              "web_admin": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "const": "ghcr.io/artisancloud/powerx-web-admin"
                  },
                  "index_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "platforms": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "linux/amd64": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "source_revision": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                          }
                        },
                        "required": [
                          "digest",
                          "source_revision"
                        ]
                      },
                      "linux/arm64": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "source_revision": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{40}$"
                          }
                        },
                        "required": [
                          "digest",
                          "source_revision"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "repository",
                  "index_digest",
                  "platforms"
                ]
              }
            },
            "required": [
              "backend",
              "web_admin"
            ]
          }
        },
        "required": [
          "release_id",
          "source_sha",
          "images"
        ]
      },
      "minItems": 1
