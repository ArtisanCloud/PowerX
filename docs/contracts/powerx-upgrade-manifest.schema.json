    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "restore_required"
        },
        "release_id": {
          "type": "string"
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "const": "ghcr.io/artisancloud/powerx-backend"
                },
                "index_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "platforms": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "linux/amd64": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "source_revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      },
                      "required": [
                        "digest",
                        "source_revision"
                      ]
                    },
                    "linux/arm64": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "source_revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      },
                      "required": [
                        "digest",
                        "source_revision"
                      ]
                    }
                  }
                }
              },
              "required": [
                "repository",
                "index_digest",
                "platforms"
              ]
            },
            "web_admin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "const": "ghcr.io/artisancloud/powerx-web-admin"
                },
                "index_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "platforms": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "linux/amd64": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "source_revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      },
                      "required": [
                        "digest",
                        "source_revision"
                      ]
                    },
                    "linux/arm64": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "source_revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      },
                      "required": [
                        "digest",
                        "source_revision"
                      ]
                    }
                  }
                }
              },
              "required": [
                "repository",
                "index_digest",
                "platforms"
              ]
            }
          },
          "required": [
            "backend",
            "web_admin"
          ]
        },
        "restore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_writes_after_upgrade": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "release_id",
        "images",
        "restore",
        "new_writes_after_upgrade"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed"
        },
        "ci_run_url": {
          "type": "string",
          "pattern": "^https://github.com/ArtisanCloud/PowerX/actions/runs/[0-9]+$"
        },
        "tested_upgrade_platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform": {
                "enum": [
                  "linux/amd64",
                  "linux/arm64"
                ]
              },
              "artifact": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "platform",
              "artifact",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "status",
        "ci_run_url",
        "tested_upgrade_platforms",
        "reports"
