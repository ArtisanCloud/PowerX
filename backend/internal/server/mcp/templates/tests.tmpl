{{if .HasConcurrencyTest}}
// TestConcurrency{{.EntityName}} 并发测试
func (suite *{{.EntityName}}TestSuite) TestConcurrency{{.EntityName}}() {
	const goroutineCount = 10
	const operationsPerGoroutine = 5

	// 创建错误通道
	errorChan := make(chan error, goroutineCount*operationsPerGoroutine)
	doneChan := make(chan bool, goroutineCount)

	// 启动多个goroutine进行并发操作
	for i := 0; i < goroutineCount; i++ {
		go func(routineID int) {
			defer func() { doneChan <- true }()

			for j := 0; j < operationsPerGoroutine; j++ {
				// 创建
				createReq := &{{.PackageName}}.Create{{.EntityName}}Request{
{{range .ConcurrencyTestFields}}					{{.Name}}: {{.Value}},
{{end}}				}

				created, err := suite.useCase.Create{{.EntityName}}(suite.ctx, createReq)
				if err != nil {
					errorChan <- err
					return
				}

				// 获取
				_, err = suite.useCase.Get{{.EntityName}}(suite.ctx, created.ID)
				if err != nil {
					errorChan <- err
					return
				}

				// 删除
				err = suite.useCase.Delete{{.EntityName}}(suite.ctx, created.ID)
				if err != nil {
					errorChan <- err
					return
				}
			}
		}(i)
	}

	// 等待所有goroutine完成
	for i := 0; i < goroutineCount; i++ {
		select {
		case <-doneChan:
			// goroutine完成
		case err := <-errorChan:
			suite.Fail("并发测试失败", err.Error())
		case <-time.After(30 * time.Second):
			suite.Fail("并发测试超时")
		}
	}

	// 检查是否有错误
	select {
	case err := <-errorChan:
		suite.Fail("并发测试出现错误", err.Error())
	default:
		// 没有错误
	}
}
{{end}}

