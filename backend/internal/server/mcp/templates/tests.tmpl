// SetupSuite 设置测试套件
func (suite *{{.EntityName}}TestSuite) SetupSuite() {
	// 初始化测试数据库
	suite.db = testutil.SetupTestDB()

	// 初始化仓储
	suite.repository = {{.PackageName}}.New{{.EntityName}}Repository(suite.db)

	// 初始化用例
	suite.useCase = {{.PackageName}}.New{{.EntityName}}UseCase(suite.repository)

{{if .HasMocks}}	// 初始化Mock
	suite.mockRepo = &mocks.{{.EntityName}}Repository{}
{{end}}
	// 初始化上下文
	suite.ctx = context.Background()

	// 迁移数据库
	err := suite.db.AutoMigrate(&{{.PackageName}}.{{.EntityName}}{})
	suite.Require().NoError(err)
}

// TearDownSuite 清理测试套件
func (suite *{{.EntityName}}TestSuite) TearDownSuite() {
	testutil.CleanupTestDB(suite.db)
}

// SetupTest 设置每个测试
