{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateAuditOutput",
  "type": "object",
  "properties": {
    "scanned_total": { "type": "integer", "minimum": 0 },
    "selected_template_id": { "type": "string" },
    "updated": { "type": "boolean" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "payload": { "type": "object" }
        },
        "required": ["name", "payload"],
        "additionalProperties": true
      }
    }
  },
  "required": ["scanned_total"],
  "additionalProperties": true
}
