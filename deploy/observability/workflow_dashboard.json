{
  "title": "Workflow Runtime Overview",
  "description": "\u6807\u51c6\u5316\u5de5\u4f5c\u6d41\u8fd0\u884c\u6001\u4eea\u8868\u677f\uff1a\u91cd\u8bd5\u3001\u8865\u507f\u3001\u5bfc\u51fa\u7b49\u6838\u5fc3\u6307\u6807",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Compensation Backlog",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(workflow_compensation_running)",
          "legendFormat": "running",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Retry Schedule Rate",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(workflow_retry_scheduled_total[5m]))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Retry Queue Depth",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "workflow_retry_queue_depth",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Control Operations (5m)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(workflow_control_events_total[5m])) by (action)",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Integration Gateway Invocations",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(integration_gateway_invocations_total[5m])) by (channel)",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Hits",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(integration_gateway_rate_limit_hits_total[5m])) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "type": "stat",
      "title": "Event Publication Pending",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(integration_gateway_event_publications{status!=\"sent\"})",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto"
      }
    }
  ]
}