# Select BOTH application images from the same successful release.
POWERX_BACKEND_IMAGE=ghcr.io/artisancloud/powerx-backend:REPLACE_WITH_PUBLISHED_TAG
POWERX_WEB_IMAGE=ghcr.io/artisancloud/powerx-web-admin:REPLACE_WITH_PUBLISHED_TAG
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
GATEWAY_IMAGE=nginx:alpine
PULL_POLICY=missing
COMPOSE_PROJECT_NAME=powerx-dev
DEPLOYMENT_ENV=dev
# 已安装实例升级并启动目标镜像时设为 1；首次安装保持 0。
POWERX_UPGRADE_MODE=0
PUBLIC_ORIGIN=http://127.0.0.1:18080
PUBLIC_WS_ORIGIN=ws://127.0.0.1:18080
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
POWERX_DATA_DIR=./data

# 恢复副本的只读客户端接入默认关闭；不把容器内部 postgres:5432 当作桌面连接地址。
# SSH 接入需要显式启用覆盖文件（Linux/macOS）：
# COMPOSE_FILE=compose.yml:compose.restore-access.yml
# POWERX_RESTORE_POSTGRES_PORT=15432
# POWERX_RESTORE_LOCAL_PORT=15432
# 自有客户端入口可直接填写以下配置；完整规则见 README“恢复副本客户端连接”。
POWERX_OPS_RESTORE_ACCESS_MODE=
POWERX_OPS_RESTORE_CLIENT_HOST=
POWERX_OPS_RESTORE_CLIENT_PORT=
POWERX_OPS_RESTORE_CLIENT_SSL_MODE=
POWERX_OPS_RESTORE_TUNNEL_HOST=
POWERX_OPS_RESTORE_TUNNEL_PORT=
