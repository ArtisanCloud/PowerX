# Select BOTH application images from the same successful release.
POWERX_BACKEND_IMAGE=ghcr.io/artisancloud/powerx-backend:REPLACE_WITH_PUBLISHED_TAG
POWERX_WEB_IMAGE=ghcr.io/artisancloud/powerx-web-admin:REPLACE_WITH_PUBLISHED_TAG
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
GATEWAY_IMAGE=nginx:alpine
PULL_POLICY=missing
COMPOSE_PROJECT_NAME=powerx-dev
DEPLOYMENT_ENV=dev
PUBLIC_ORIGIN=http://127.0.0.1:18080
PUBLIC_WS_ORIGIN=ws://127.0.0.1:18080
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
POWERX_DATA_DIR=./data
