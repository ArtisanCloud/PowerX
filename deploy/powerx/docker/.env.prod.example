POWERX_BACKEND_TAG=latest
POWERX_RUNNER_TAG=latest
POWERX_WEB_ADMIN_TAG=latest
POWERX_BACKEND_PORT=8080
POWERX_WEB_ADMIN_PORT=3000
POWERX_POSTGRES_PORT=5432
POWERX_ENV=prod
POWERX_MODE=docker

# 默认走 compose 内置 postgres + redis（开箱即用）
# 如果使用外部数据库，改写 DATABASE_DSN 即可
DATABASE_DSN=postgres://powerx:powerx@postgres:5432/powerx?sslmode=disable
REDIS_ADDR=redis:6379

# 内置 postgres 初始化账号（仅 compose 内置库生效）
POSTGRES_DB=powerx
POSTGRES_USER=powerx
POSTGRES_PASSWORD=powerx
