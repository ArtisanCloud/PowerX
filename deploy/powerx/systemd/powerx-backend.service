[Unit]
Description=PowerX Backend Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=powerx
Group=powerx
WorkingDirectory=/
EnvironmentFile=-/etc/powerx/powerx.env
ExecStart=/bin/sh -c 'ROOT=${POWERX_LINKS_ROOT:-/opt/powerx}; exec "$ROOT/backend/powerx"'
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
