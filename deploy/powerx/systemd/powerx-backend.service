[Unit]
Description=PowerX Backend Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=powerx
Group=powerx
WorkingDirectory=/opt/powerx/backend
EnvironmentFile=/etc/powerx/powerx.env
ExecStart=/bin/sh -c 'CORE_X_SERVER_PORT=${POWERX_BACKEND_PORT:-8080} exec /opt/powerx/backend/powerx'
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
