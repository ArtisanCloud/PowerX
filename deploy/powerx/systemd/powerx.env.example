# PowerX Runner 环境变量模板（systemd）
#
# 首次部署时，switch-release-systemd.sh 会自动将该模板复制到：
#   /etc/powerx/powerx.env
#
# 默认可留空；按需填充 Runner 需要的环境变量。
# 生产环境建议固定关键路径，避免依赖工作目录。

POWERX_ENV=prod
POWERX_BACKEND_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
NODE_BIN=/usr/bin/node

# Runtime / release paths
POWERX_RUNTIME_ROOT=/etc/powerx
POWERX_CONFIG=/etc/powerx/config.yaml

# JWT signing identity: Setup generates/persists it automatically.
# Manual first install without Setup: database init-secrets -config /etc/powerx/config.yaml
# Only override for externally managed keys or multi-instance deployments.
# POWERX_AUTH_JWT_SECRET=
POWERX_LINKS_ROOT=/opt/powerx

# Optional independent system snapshot directory (absolute path).
# POWERX_SNAPSHOT_DIRECTORY=/var/lib/powerx/system-snapshots

# Core proxy base (backend API entry for plugin/runtime sidecars)
POWERX_HTTP_PROXY_BASE=http://127.0.0.1:8080

# Gateway public bases for plugin host-values contract injection.
# Do not use loopback in remote deployment, or browser WS will connect to itself.
POWERX_GATEWAY_BASE_URL=https://agent.example.com
POWERX_GATEWAY_WS_BASE_URL=wss://agent.example.com

# Plugin supervisor stdio forwarding:
# keep enabled so host-mode plugin stdout/stderr can be collected by journald/promtail.
POWERX_SUPERVISOR_FORWARD_STDIO=true

# Backup ops
POWERX_OPS_SCRIPT_DIR=/opt/powerx/backend/scripts/ops
POWERX_OPS_BACKUP_ARTIFACT_DIR=/var/lib/powerx/ops-backup/artifacts
POWERX_OPS_BACKUP_SCRIPT_TIMEOUT=30m

# Optional: override backup source DSN (when different from core database.dsn)
# POWERX_OPS_BACKUP_SOURCE_DSN=postgres://user:pass@127.0.0.1:5432/powerx?sslmode=disable

# 媒体／日志／数据库文件归档：专用配置 0600，包含来源及 SSH 凭据引用。
# POWERX_OPS_ARCHIVE_CONFIG=/etc/powerx/archives.yaml
