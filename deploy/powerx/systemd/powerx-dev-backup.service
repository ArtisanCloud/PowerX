[Unit]
Description=PowerX development persistent backup scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=powerx
Group=powerx
WorkingDirectory=/
EnvironmentFile=/etc/powerx-dev/powerx.env
ExecStart=/bin/sh -c 'ROOT=${POWERX_LINKS_ROOT:-/opt/powerx-dev}; exec "$ROOT/backend/database" backup-run -config /etc/powerx-dev/config.yaml'
TimeoutStartSec=2h
UMask=0077
