POWERX_ENV=dev
POWERX_BACKEND_PORT=8077
POWERX_WEB_ADMIN_PORT=3030
POWERX_CONFIG=backend/etc/config.yaml
POWERX_OPS_SCRIPT_DIR=backend/scripts/ops
POWERX_OPS_BACKUP_ARTIFACT_DIR=backend/tmp/ops-backup/artifacts
POWERX_OPS_BACKUP_SCRIPT_TIMEOUT=30m
CORE_X_LOG_RETENTION_ENABLED=true
CORE_X_LOG_RETENTION_CRON=10 3 * * *
CORE_X_LOG_RETENTION_TIMEZONE=Asia/Shanghai
CORE_X_LOG_RETENTION_DEFAULT_DAYS=30
CORE_X_LOG_RETENTION_FILE_PATHS=logs
CORE_X_LOG_RETENTION_BATCH_SIZE=5000
CORE_X_LOG_RETENTION_MAX_DELETE_ROWS=200000
