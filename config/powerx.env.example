POWERX_ENV=dev
POWERX_BACKEND_PORT=8077
POWERX_WEB_ADMIN_PORT=3030
POWERX_CONFIG=backend/etc/config.yaml
# 建议使用绝对路径（避免受工作目录影响）；留空时走自动探测 fallback
POWERX_OPS_SCRIPT_DIR=
POWERX_OPS_BACKUP_ARTIFACT_DIR=
POWERX_OPS_BACKUP_SCRIPT_TIMEOUT=30m
CORE_X_LOG_CONSOLE=false
CORE_X_LOG_FILE_ENABLE=true
# 生产建议：/var/log/powerx/info.log /var/log/powerx/error.log /var/log/powerx/agent_debug
CORE_X_LOG_FILE_INFO_PATH=
CORE_X_LOG_FILE_ERROR_PATH=
CORE_X_LOG_AGENT_DEBUG_DIR=
# 插件子进程 stdout/stderr 是否透传到主进程控制台
POWERX_SUPERVISOR_FORWARD_STDIO=false
CORE_X_LOG_RETENTION_ENABLED=true
CORE_X_LOG_RETENTION_CRON=10 3 * * *
CORE_X_LOG_RETENTION_TIMEZONE=Asia/Shanghai
CORE_X_LOG_RETENTION_DEFAULT_DAYS=30
CORE_X_LOG_RETENTION_FILE_PATHS=
CORE_X_LOG_RETENTION_BATCH_SIZE=5000
CORE_X_LOG_RETENTION_MAX_DELETE_ROWS=200000
