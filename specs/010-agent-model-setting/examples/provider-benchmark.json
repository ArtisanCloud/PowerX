{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": "default",
  "suite": "benchmark",
  "thresholdHours": 24,
  "providers": [
    {
      "name": "openai-benchmark",
      "primary_endpoint": "https://api.openai.com/v1",
      "capabilities": ["llm"],
      "regions": ["us-east-1"],
      "tenantWhitelist": [
        {
          "tenantId": "demo",
          "environment": "staging"
        }
      ],
      "credentials": {
        "api_key": "${OPENAI_KEY}"
      },
      "publish": {
        "rolloutStrategy": "gray"
      }
    }
  ]
}
