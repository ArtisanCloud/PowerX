{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerx.plugin-tool-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_key",
    "version",
    "semantics",
    "input",
    "output",
    "labels"
  ],
  "properties": {
    "schema": {
      "const": "powerx.plugin-tool-contract/v1"
    },
    "tool_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "semantics": {
      "const": "pure_computation"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^/[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_key",
              "label_key",
              "unit",
              "scope"
            ],
            "properties": {
              "field_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "label_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "not": {
                  "enum": [
                    "%",
                    "％"
                  ]
                }
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "additionalProperties",
            "required",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^/[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_key",
              "label_key",
              "unit",
              "scope"
            ],
            "properties": {
              "field_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "label_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "not": {
                  "enum": [
                    "%",
                    "％"
                  ]
                }
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "additionalProperties",
            "required",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "additionalProperties": {
              "const": false
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "pattern",
                  "maxLength"
                ],
                "properties": {
                  "type": {
                    "const": "string"
                  },
                  "pattern": {
                    "const": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 80
                  }
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en-US",
        "zh-CN"
      ],
      "properties": {
        "en-US": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "zh-CN": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
