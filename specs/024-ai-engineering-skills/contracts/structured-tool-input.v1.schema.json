{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerx.agent.structured-tool-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "values"
  ],
  "properties": {
    "schema": {
      "const": "powerx.agent.structured-tool-input/v1"
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
      }
    }
  }
}
