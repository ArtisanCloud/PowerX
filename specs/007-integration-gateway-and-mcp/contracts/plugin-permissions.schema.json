{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerx.local/schemas/plugin-permissions.schema.json",
  "title": "PowerX Plugin Permission Declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["permissions"],
  "properties": {
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/permission" }
    }
  },
  "$defs": {
    "localeText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permissionCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+:[a-z][a-z0-9_]*$"
    },
    "roleCode": {
      "type": "string",
      "enum": ["role_owner", "role_admin", "role_user", "role_readonly", "role_vendor"]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "permission_code", "module", "title_i18n", "description_i18n", "risk_level", "data_scope"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["menu", "page", "action", "api"]
        },
        "permission_code": { "$ref": "#/$defs/permissionCode" },
        "module": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "menu" }
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "menu_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(com\\.powerx\\.plugins?|plugin\\.|/_p/|/api/v1)"
            }
          }
        },
        "page_permission_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/permissionCode" },
          "uniqueItems": true
        },
        "title_i18n": { "$ref": "#/$defs/localeText" },
        "description_i18n": { "$ref": "#/$defs/localeText" },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "data_scope": {
          "type": "string",
          "enum": ["tenant", "owner", "self", "factory", "department", "global"]
        },
        "default_role_grants": {
          "type": "array",
          "items": { "$ref": "#/$defs/roleCode" },
          "uniqueItems": true
        },
        "business_permission_code": { "$ref": "#/$defs/permissionCode" },
        "independent": {
          "type": "boolean",
          "default": false
        },
        "protocol_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/protocolBinding" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "menu" } },
            "required": ["type"]
          },
          "then": {
            "required": ["menu_path"],
            "properties": {
              "permission_code": {
                "type": "string",
                "pattern": "^menu\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+:[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["page", "action", "api"] } },
            "required": ["type"]
          },
          "then": {
            "required": ["resource", "action"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "api" } },
            "required": ["type"]
          },
          "then": {
            "required": ["protocol_bindings"],
            "anyOf": [
              { "required": ["business_permission_code"] },
              {
                "properties": { "independent": { "const": true } },
                "required": ["independent"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "page" } },
            "required": ["type"]
          },
          "then": {
            "required": ["protocol_bindings"],
            "properties": {
              "protocol_bindings": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/protocolBinding" },
                    {
                      "properties": {
                        "channel": { "const": "rest" },
                        "method": { "const": "GET" },
                        "actor_context": { "const": "admin_user" },
                        "resource_scope": { "const": "tenant" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "method", "path", "actor_context", "resource_scope"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["rest"]
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?!api/v1)(?!_p/)(?!.*[{}:]).*"
        },
        "actor_context": {
          "type": "string",
          "enum": ["admin_user", "service_actor", "web_user", "mini_app_user", "customer_actor"]
        },
        "resource_scope": {
          "type": "string",
          "enum": ["tenant", "owner", "self", "department", "global"]
        }
      }
    }
  }
}
