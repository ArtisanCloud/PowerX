# /var/log/syslog is excluded from the original rsyslog stanza while this is installed.
/var/log/syslog {
    daily
    rotate 336
    maxage 7
    maxsize 100M
    compress
    missingok
    notifempty
    create 0640 syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
